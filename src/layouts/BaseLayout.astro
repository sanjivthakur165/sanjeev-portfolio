---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NightPalmBackground from '../components/NightPalmBackground.astro';
import { siteConfig } from '../data/seo-config';
import { pagePath, pageUrl } from '../data/urls';
import { profileData } from '../data/profile';
import { buildSchemaGraph, type PageType, type ArticleInput } from '../data/schema';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  pageType?: PageType;
  caseStudySlug?: string;
  article?: ArticleInput;
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description = siteConfig.defaultDescription,
  canonicalPath = '',
  image = '/images/og-image.png',
  imageAlt = `${profileData.name} — ${profileData.role}, ${profileData.location}`,
  type = 'website',
  pageType = 'generic',
  caseStudySlug,
  article,
  breadcrumbs = []
} = Astro.props;

const pageTitle = title
  ? `${title} | ${siteConfig.siteName}`
  : siteConfig.defaultTitle;

const path = pagePath(canonicalPath || '/');
const canonicalUrl = pageUrl(path);
const ogImageUrl = image.startsWith('http') ? image : `${siteConfig.siteUrl}${image}`;

// One connected Schema.org @graph for this page (see src/data/schema.ts)
const schemaGraph = buildSchemaGraph({
  path,
  title: pageTitle,
  description,
  pageType,
  breadcrumbs,
  caseStudySlug,
  article,
  imageUrl: ogImageUrl,
});
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" title="LLM-readable site summary" href="/llms.txt" />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-FOUC Theme Script (Synchronous execution before DOM paint) -->
    <script is:inline>
      (function() {
        try {
          const theme = localStorage.getItem('theme');
          if (theme === 'night') {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'night');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'day');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content={siteConfig.themeColor} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'profile' && <meta property="profile:first_name" content={profileData.name.split(' ')[0]} />}
    {type === 'profile' && <meta property="profile:last_name" content={profileData.name.split(' ').slice(1).join(' ')} />}
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:locale" content={siteConfig.locale} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {siteConfig.twitterHandle && <meta name="twitter:creator" content={siteConfig.twitterHandle} />}

    <!-- Structured Data (JSON-LD): single connected @graph -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body class="flex flex-col min-h-screen text-pastel-dark dark:text-night-light selection:bg-rose-200 dark:selection:bg-night-magenta dark:selection:text-white transition-colors duration-300">
    <!-- Tropical Palm Tree Night Background (Visible only in Night Mode, inspired by reference image) -->
    <NightPalmBackground />

    <!-- Ambient Vice City Sunset Glow Backdrop (Day Mode only) -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden dark:hidden" aria-hidden="true">
      <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-rose-200/40 blur-3xl transition-colors duration-500"></div>
      <div class="absolute top-1/4 -right-32 w-96 h-96 rounded-full bg-orange-100/50 blur-3xl transition-colors duration-500"></div>
      <div class="absolute top-2/3 left-1/3 w-[32rem] h-[32rem] rounded-full bg-purple-100/40 blur-3xl transition-colors duration-500"></div>
    </div>

    <!-- Navigation Header with GTA VI Squiggly Highway -->
    <Header />

    <!-- Main Content -->
    <main id="main-content" class="flex-grow pt-28">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
