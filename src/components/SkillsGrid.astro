---
import { skillCategories } from '../data/skills';
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
  {skillCategories.map((cat, index) => (
    <div class={`bg-glass-card rounded-2xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 ${
      index === 4 ? 'md:col-span-2 lg:col-span-1 border-rose-300/80 dark:border-night-cyan/40' : ''
    }`}>
      <div>
        <!-- Icon & Category Title -->
        <div class="flex items-center space-x-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-rose-500/10 via-orange-500/10 to-purple-500/10 dark:from-night-cyan/15 dark:via-night-magenta/15 dark:to-night-pink/15 border border-rose-200/80 dark:border-night-cyan/30 flex items-center justify-center text-rose-600 dark:text-night-cyan transition-colors">
            {cat.icon === 'search' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            )}
            {cat.icon === 'code' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
              </svg>
            )}
            {cat.icon === 'map-pin' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            )}
            {cat.icon === 'bar-chart-2' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
            )}
            {cat.icon === 'sparkles' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
              </svg>
            )}
          </div>
          <h3 class="text-xl font-serif font-bold text-zinc-900 dark:text-night-light transition-colors">
            {cat.title}
          </h3>
        </div>

        <!-- Description -->
        <p class="text-sm text-zinc-600 dark:text-night-muted leading-relaxed mb-6 transition-colors">
          {cat.description}
        </p>

        <!-- Skills Pills -->
        <ul class="space-y-2">
          {cat.skills.map((skill) => (
            <li class="flex items-center text-sm font-medium text-zinc-800 dark:text-night-light transition-colors">
              <span class="w-1.5 h-1.5 rounded-full bg-rose-400 dark:bg-night-cyan mr-2.5 flex-shrink-0"></span>
              {skill}
            </li>
          ))}
        </ul>
      </div>

      {cat.id === 'emerging-search' && (
        <div class="mt-6 pt-4 border-t border-rose-100 dark:border-night-cyan/20 text-[11px] font-mono text-rose-600 dark:text-night-cyan bg-rose-50/60 dark:bg-night-ocean/60 p-2.5 rounded-lg transition-colors">
          Currently researching how AI search works (AEO &amp; GEO).
        </div>
      )}
    </div>
  ))}
</div>
