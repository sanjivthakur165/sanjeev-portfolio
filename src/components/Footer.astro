---
import { CornerDownRight, Map } from 'lucide-astro';
import { profileData } from '../data/profile';

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-rose-200/60 dark:border-night-cyan/20 bg-gradient-to-b from-transparent via-rose-50/40 to-rose-100/30 dark:from-night-midnight/40 dark:via-night-midnight/80 dark:to-night-midnight/95 backdrop-blur-md relative overflow-hidden transition-colors duration-500">
  
  <!-- Subtle Tropical Silhouette Accent -->
  <div class="absolute right-0 bottom-0 pointer-events-none opacity-5 dark:opacity-10 w-64 h-64" aria-hidden="true">
    <svg viewBox="0 0 200 200" fill="#E11D48" class="dark:fill-night-cyan">
      <path d="M 200 200 C 120 180 80 120 0 100 C 60 70 120 60 200 0 Z"/>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Identity Column -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-rose-500 to-orange-400 dark:from-night-magenta dark:to-night-cyan flex items-center justify-center text-white font-serif font-bold text-base shadow-sm">
            ST
          </div>
          <div>
            <span class="font-serif text-2xl font-bold tracking-tight text-zinc-900 dark:text-night-light block">
              {profileData.name}
            </span>
            <span class="text-xs font-mono uppercase tracking-widest text-rose-500 dark:text-night-cyan font-semibold">
              {profileData.role} • 4+ Years Experience
            </span>
          </div>
        </div>
        <p class="text-zinc-600 dark:text-night-muted text-sm leading-relaxed max-w-md pt-2">
          I work on technical SEO, on-page SEO and local search. No shortcuts, just steady organic growth backed by data.
        </p>
        <div class="flex items-center space-x-3 pt-2">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-rose-100 dark:bg-night-ocean text-rose-800 dark:text-night-cyan border border-rose-200 dark:border-night-cyan/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-night-cyan mr-2 animate-pulse"></span>
            Open to New Opportunities
          </span>
        </div>
      </div>

      <!-- Navigation Column -->
      <div class="space-y-4">
        <h3 class="font-serif text-base font-bold text-zinc-900 dark:text-night-light uppercase tracking-wider">
          Navigation
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="text-zinc-600 dark:text-night-muted hover:text-rose-600 dark:hover:text-night-cyan transition-colors">Home</a>
          </li>
          <li>
            <a href="/about" class="text-zinc-600 dark:text-night-muted hover:text-rose-600 dark:hover:text-night-cyan transition-colors">About & Career</a>
          </li>
          <li>
            <a href="/case-studies" class="text-zinc-600 dark:text-night-muted hover:text-rose-600 dark:hover:text-night-cyan transition-colors">Case Studies</a>
          </li>
          <li>
            <a href="/case-studies/construction" class="text-zinc-500 dark:text-night-muted/80 hover:text-rose-600 dark:hover:text-night-cyan transition-colors pl-2 inline-flex items-center gap-1.5"><CornerDownRight class="w-3.5 h-3.5" /> Construction (+200%)</a>
          </li>
          <li>
            <a href="/case-studies/electrical" class="text-zinc-500 dark:text-night-muted/80 hover:text-rose-600 dark:hover:text-night-cyan transition-colors pl-2 inline-flex items-center gap-1.5"><CornerDownRight class="w-3.5 h-3.5" /> Electrical Contracting (~3x)</a>
          </li>
          <li>
            <a href="/projects/this-website" class="text-zinc-600 dark:text-night-muted hover:text-rose-600 dark:hover:text-night-cyan transition-colors">How I Built This Site</a>
          </li>
          <li>
            <a href="/contact" class="text-zinc-600 dark:text-night-muted hover:text-rose-600 dark:hover:text-night-cyan transition-colors">Contact</a>
          </li>
        </ul>
      </div>

      <!-- Direct Contact Column -->
      <div class="space-y-4">
        <h3 class="font-serif text-base font-bold text-zinc-900 dark:text-night-light uppercase tracking-wider">
          Contact
        </h3>
        <ul class="space-y-3 text-sm text-zinc-600 dark:text-night-muted">
          <li class="flex items-start space-x-2">
            <svg class="w-4 h-4 text-rose-500 dark:text-night-cyan mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href={`mailto:${profileData.email}`} class="hover:text-rose-600 dark:hover:text-night-cyan break-all transition-colors">
              {profileData.email}
            </a>
          </li>
          <li class="flex items-start space-x-2">
            <svg class="w-4 h-4 text-rose-500 dark:text-night-cyan mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href={`tel:${profileData.phone}`} class="hover:text-rose-600 dark:hover:text-night-cyan transition-colors">
              {profileData.phone}
            </a>
          </li>
          <li class="flex items-start space-x-2">
            <svg class="w-4 h-4 text-rose-500 dark:text-night-cyan mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{profileData.location}</span>
          </li>
          <li class="flex items-start space-x-2 pt-1">
            <a 
              href={profileData.linkedIn}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-lg bg-rose-50 dark:bg-night-ocean hover:bg-rose-100 dark:hover:bg-night-ocean/70 text-rose-700 dark:text-night-cyan border border-rose-200 dark:border-night-cyan/30 transition-colors"
            >
              <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              Connect on LinkedIn
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Confidentiality Statement -->
    <div class="mt-12 pt-8 border-t border-rose-200/50 dark:border-night-cyan/15 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 dark:text-night-muted/70 gap-4">
      <p>
        © {currentYear} {profileData.name}. All rights reserved. Built with Astro &amp; Tailwind CSS.
      </p>
      <p class="text-zinc-400 dark:text-night-muted/50 text-center sm:text-right">
        Client case studies are anonymized to protect client confidentiality.
      </p>
      <nav aria-label="Site index" class="flex items-center gap-4 font-mono">
        <a href="/sitemap" class="inline-flex items-center gap-1.5 hover:text-rose-600 dark:hover:text-night-cyan transition-colors"><Map class="w-3.5 h-3.5" aria-hidden="true" /> Sitemap</a>
        <a href="/sitemap.xml" class="hover:text-rose-600 dark:hover:text-night-cyan transition-colors">XML</a>
        <a href="/llms.txt" class="hover:text-rose-600 dark:hover:text-night-cyan transition-colors">llms.txt</a>
      </nav>
    </div>
  </div>
</footer>
