---
import { BadgeCheck, ShieldCheck, Target } from 'lucide-astro';
import { profileData } from '../data/profile';
---

<div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-rose-500 via-rose-400 to-orange-400 dark:from-night-ocean dark:via-night-electric dark:to-night-cyan/90 p-8 sm:p-14 text-white shadow-2xl shadow-rose-500/25 dark:shadow-night-midnight/70 border border-transparent dark:border-night-cyan/30 transition-all duration-300">
  
  <!-- Ambient Tropical Silhouette Background -->
  <div class="absolute inset-0 pointer-events-none opacity-10 dark:opacity-15" aria-hidden="true">
    <svg viewBox="0 0 800 400" fill="white" class="w-full h-full object-cover">
      <path d="M 0 400 C 200 300 400 350 800 200 L 800 400 Z"/>
    </svg>
  </div>

  <div class="relative z-10 max-w-3xl mx-auto text-center space-y-6">
    <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-mono uppercase tracking-wider font-semibold bg-white/20 text-white border border-white/30 backdrop-blur-xs">
      Hiring or Need SEO Help?
    </span>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold tracking-tight text-white leading-tight">
      Want More People to Find Your Website?
    </h2>

    <p class="text-base sm:text-lg text-rose-50 dark:text-night-light/90 leading-relaxed max-w-xl mx-auto">
      Whether you're hiring an in-house SEO Specialist or need help growing organic traffic, I'd like to hear from you.
    </p>

    <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/contact"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-full text-base font-bold text-rose-600 bg-white hover:bg-rose-50 dark:bg-night-cyan dark:hover:bg-white dark:text-night-midnight shadow-lg shadow-black/10 hover:shadow-xl transition-all transform hover:-translate-y-0.5 active:translate-y-0"
      >
        Get in Touch
        <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>

      <a
        href={`mailto:${profileData.email}`}
        class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-full text-base font-semibold text-white bg-black/15 hover:bg-black/25 dark:bg-night-midnight/50 dark:hover:bg-night-midnight/80 border border-white/30 dark:border-night-cyan/40 backdrop-blur-xs transition-colors"
      >
        <svg class="mr-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        Email Me
      </a>
    </div>

    <div class="pt-4 text-xs font-mono text-rose-100 dark:text-night-light/80 flex flex-wrap items-center justify-center gap-4 sm:gap-6">
      <span class="inline-flex items-center gap-1.5"><BadgeCheck class="w-4 h-4 flex-shrink-0" /> 4+ years in SEO</span>
      <span class="inline-flex items-center gap-1.5"><ShieldCheck class="w-4 h-4 flex-shrink-0" /> Client work kept confidential</span>
      <span class="inline-flex items-center gap-1.5"><Target class="w-4 h-4 flex-shrink-0" /> Technical &amp; local SEO</span>
    </div>
  </div>

</div>
