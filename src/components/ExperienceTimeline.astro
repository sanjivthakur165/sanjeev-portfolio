---
import { workExperience, educationHistory } from '../data/experience';
---

<div class="max-w-4xl mx-auto space-y-12">
  
  <!-- Experience List -->
  <div class="relative border-l-2 border-rose-200/80 dark:border-night-cyan/30 ml-4 sm:ml-8 pl-6 sm:pl-10 space-y-12 transition-colors duration-300">
    {workExperience.map((job) => (
      <div class="relative group">
        
        <!-- Timeline Marker Node -->
        <div class={`absolute -left-[31px] sm:-left-[47px] top-1.5 w-5 h-5 rounded-full border-4 border-white dark:border-night-midnight ${
          job.isCurrent
            ? 'bg-rose-500 dark:bg-night-cyan shadow-md shadow-rose-500/40 dark:shadow-night-cyan/50 ring-4 ring-rose-100 dark:ring-night-cyan/20'
            : 'bg-zinc-300 dark:bg-night-electric'
        } transition-all`}></div>

        <!-- Job Card -->
        <div class="bg-glass-card rounded-2xl p-6 sm:p-8 transition-all hover:border-rose-300 dark:hover:border-night-cyan/50">
          
          <!-- Header -->
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
            <div>
              <div class="flex items-center space-x-2">
                <span class="text-xs font-mono font-semibold px-2.5 py-0.5 rounded-full uppercase tracking-wider bg-rose-100 dark:bg-night-ocean text-rose-700 dark:text-night-cyan transition-colors">
                  {job.type}
                </span>
                {job.isCurrent && (
                  <span class="text-xs font-mono font-semibold px-2.5 py-0.5 rounded-full uppercase tracking-wider bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 transition-colors">
                    Current Role
                  </span>
                )}
              </div>
              <h3 class="text-2xl font-serif font-bold text-zinc-900 dark:text-night-light mt-2 transition-colors">
                {job.role}
              </h3>
              <div class="text-base font-semibold text-rose-600 dark:text-night-cyan transition-colors">
                {job.company} {job.location && <span class="text-zinc-500 dark:text-night-muted font-normal">• {job.location}</span>}
              </div>
            </div>

            <div class="text-sm font-mono text-zinc-500 dark:text-night-muted bg-white/70 dark:bg-night-ocean/80 px-3 py-1.5 rounded-lg border border-rose-100 dark:border-night-cyan/20 self-start sm:self-auto transition-colors">
              {job.period}
            </div>
          </div>

          <!-- Summary -->
          <p class="text-sm sm:text-base text-zinc-700 dark:text-night-muted leading-relaxed mb-6 transition-colors">
            {job.summary}
          </p>

          <!-- Key Responsibilities -->
          <div class="space-y-2 mb-6">
            <h4 class="text-xs font-mono uppercase tracking-wider text-zinc-400 dark:text-night-muted font-bold">
              Core Responsibilities &amp; Impact
            </h4>
            <ul class="space-y-2 text-sm text-zinc-600 dark:text-night-muted">
              {job.responsibilities.map((resp) => (
                <li class="flex items-start">
                  <span class="text-rose-500 dark:text-night-cyan font-bold mr-2.5 mt-0.5 flex-shrink-0">›</span>
                  <span>{resp}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Highlights Pills -->
          <div class="pt-4 border-t border-rose-100 dark:border-night-cyan/20 flex flex-wrap gap-2 transition-colors">
            {job.keyHighlights.map((hl) => (
              <span class="text-xs font-medium px-2.5 py-1 rounded-md bg-white dark:bg-night-ocean/80 border border-rose-200/60 dark:border-night-cyan/30 text-zinc-800 dark:text-night-light shadow-2xs transition-colors">
                ★ {hl}
              </span>
            ))}
          </div>

        </div>
      </div>
    ))}
  </div>

  <!-- Education Section -->
  <div class="mt-16 pt-10 border-t border-rose-200/60 dark:border-night-cyan/20 transition-colors">
    <div class="flex items-center space-x-3 mb-6">
      <div class="w-8 h-8 rounded-lg bg-rose-100 dark:bg-night-ocean text-rose-600 dark:text-night-cyan flex items-center justify-center font-bold transition-colors">
        🎓
      </div>
      <h3 class="font-serif text-2xl font-bold text-zinc-900 dark:text-night-light transition-colors">Education</h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {educationHistory.map((edu) => (
        <div class="bg-glass-card rounded-xl p-5 border border-rose-100 dark:border-night-cyan/20">
          <div class="flex justify-between items-start">
            <div>
              <h4 class="font-serif font-bold text-base text-zinc-900 dark:text-night-light transition-colors">{edu.degree}</h4>
              <p class="text-sm text-zinc-600 dark:text-night-muted mt-1 transition-colors">{edu.institution}</p>
            </div>
            <span class="text-xs font-mono font-medium text-rose-600 dark:text-night-cyan bg-rose-50 dark:bg-night-ocean px-2 py-1 rounded border border-rose-200 dark:border-night-cyan/30 transition-colors">
              {edu.period}
            </span>
          </div>
          {edu.grade && (
            <div class="mt-3 text-xs font-mono text-zinc-500 dark:text-night-muted transition-colors">
              Academic Record: <strong class="text-zinc-800 dark:text-night-light">{edu.grade}</strong>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

</div>
