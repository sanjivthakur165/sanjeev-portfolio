---
// GTA VI Vice City Squiggly Scroll Highway
// An undulating, wavy highway positioned right below the header with a steering supercar that stays 100% visible throughout scrolling
---

<div
  id="squiggly-road-wrap"
  class="relative w-full h-7 overflow-visible bg-white/60 dark:bg-night-midnight/80 backdrop-blur-md border-t border-b border-rose-100/80 dark:border-night-cyan/20 select-none pointer-events-none transition-colors duration-300"
  role="progressbar"
  aria-label="Page reading progress"
  aria-valuenow="0"
  aria-valuemin="0"
  aria-valuemax="100"
>
  <!-- Full-width Squiggly Highway SVG -->
  <svg
    id="squiggly-svg"
    class="w-full h-full overflow-visible"
    viewBox="0 0 1200 28"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Sunset Highway Active Gradient (Day) -->
      <linearGradient id="wavySunsetGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#F43F5E" />
        <stop offset="35%" stop-color="#FB7185" />
        <stop offset="70%" stop-color="#FB923C" />
        <stop offset="100%" stop-color="#E11D48" />
      </linearGradient>

      <!-- Neon Highway Active Gradient (Night - Vice City Cyan, Magenta & Amber) -->
      <linearGradient id="wavyNeonGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#00E5FF" />
        <stop offset="45%" stop-color="#FF2E93" />
        <stop offset="80%" stop-color="#FFB03A" />
        <stop offset="100%" stop-color="#00E5FF" />
      </linearGradient>

      <!-- Highway Glow Filter -->
      <filter id="highwayGlow" x="-20%" y="-40%" width="140%" height="180%">
        <feDropShadow dx="0" dy="1" stdDeviation="2.5" flood-color="#F43F5E" flood-opacity="0.6" />
      </filter>

      <!-- Highway Neon Glow Filter (Night) -->
      <filter id="highwayNeonGlow" x="-20%" y="-40%" width="140%" height="180%">
        <feDropShadow dx="0" dy="1" stdDeviation="3" flood-color="#00E5FF" flood-opacity="0.8" />
      </filter>

      <!-- Vice City Supercar Paint Gradient -->
      <linearGradient id="wavyCarPaint" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#BE123C" />
        <stop offset="40%" stop-color="#F43F5E" />
        <stop offset="75%" stop-color="#FB7185" />
        <stop offset="100%" stop-color="#FB923C" />
      </linearGradient>

      <!-- Windshield Twilight Reflection -->
      <linearGradient id="wavyCarGlass" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.95" />
        <stop offset="100%" stop-color="#C084FC" stop-opacity="0.95" />
      </linearGradient>

      <!-- Headlight Beam -->
      <linearGradient id="wavyHeadlight" x1="0%" y1="50%" x2="100%" y2="50%">
        <stop offset="0%" stop-color="#FEF08A" stop-opacity="0.85" />
        <stop offset="100%" stop-color="#FED7AA" stop-opacity="0" />
      </linearGradient>

      <!-- Car Shadow -->
      <filter id="wavyCarShadow" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="1.5" stdDeviation="2.5" flood-color="#F43F5E" flood-opacity="0.65" />
      </filter>
    </defs>

    <!-- Base Road Track (Unlit Wavy Highway) -->
    <path
      id="wavy-road-base"
      fill="none"
      stroke="rgba(254, 205, 211, 0.55)"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Dashed Center Line -->
    <path
      id="wavy-road-dashes"
      fill="none"
      stroke="rgba(244, 63, 94, 0.35)"
      stroke-width="1.2"
      stroke-dasharray="5, 6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Active Filled Road (Lights up with sunset gradient as you scroll) -->
    <path
      id="wavy-road-active"
      fill="none"
      stroke="url(#wavySunsetGrad)"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter="url(#highwayGlow)"
    />

    <!-- Checkered Finish Line Marker at the right edge -->
    <g id="wavy-finish-line" class="transition-transform duration-300">
      <rect x="-4" y="5" width="8" height="18" fill="#18181B" rx="1.5" />
      <rect x="-4" y="5" width="4" height="4.5" fill="#FFFFFF" />
      <rect x="0" y="9.5" width="4" height="4.5" fill="#FFFFFF" />
      <rect x="-4" y="14" width="4" height="4.5" fill="#FFFFFF" />
      <rect x="0" y="18.5" width="4" height="4.5" fill="#FFFFFF" />
    </g>

    <!-- GTA VI Supercar Runner -->
    <g id="wavy-car-runner" style="transform-origin: 0 0; will-change: transform;">
      <!-- Anchored around center of chassis: offset (-23, -10) -->
      <g transform="translate(-23, -10)">
        
        <!-- Forward Headlight Beam -->
        <polygon points="46,14 64,10 64,18" fill="url(#wavyHeadlight)" opacity="0.9" />

        <!-- Rear Speed Flame -->
        <path d="M 2 13 Q -4 14 0 15 Q -5 16 1 17 Z" fill="#F43F5E" opacity="0.9" />

        <!-- Car Chassis -->
        <g filter="url(#wavyCarShadow)">
          <path
            d="M 4 15 
               L 8 15 
               A 4 4 0 0 1 16 15 
               L 33 15 
               A 4 4 0 0 1 41 15 
               L 45 15 
               C 47 15 48 14 48 12.5 
               L 47 11 
               C 46 9.5 44 9 42 8.5 
               L 35 7.5 
               L 28 4.5 
               L 16 4.5 
               L 10 7.5 
               L 3 8 
               C 2 8 1.5 9 1.5 10 
               L 1.5 12 
               C 1.5 13.5 2.5 15 4 15 Z"
            fill="url(#wavyCarPaint)"
          />

          <!-- Body Accent Line -->
          <path d="M 11 11.5 L 34 10.5" stroke="#FFE4E6" stroke-width="0.7" stroke-linecap="round" opacity="0.85" />

          <!-- Rear Spoiler Wing -->
          <path d="M 1 6.5 L 6 6.5 L 5 8 L 2 8 Z" fill="#9F1239" />

          <!-- Windshield & Side Glass -->
          <polygon points="17,5.5 27,5.5 33,8 15,8" fill="url(#carGlass)" stroke="#18181B" stroke-width="0.3" />

          <!-- Headlight Lens -->
          <circle cx="46" cy="12" r="1.3" fill="#FEF08A" />

          <!-- Taillight Neon -->
          <rect x="1.5" y="11" width="1.2" height="2.2" rx="0.4" fill="#EF4444" />
        </g>

        <!-- Rear Wheel (Spins via JS) -->
        <g id="wavy-wheel-rear" style="transform-origin: 12px 15px;">
          <circle cx="12" cy="15" r="3.4" fill="#18181B" stroke="#64748B" stroke-width="0.8" />
          <circle cx="12" cy="15" r="1.7" fill="#F43F5E" />
          <line x1="12" y1="12.5" x2="12" y2="17.5" stroke="#FFFFFF" stroke-width="0.5" />
          <line x1="9.5" y1="15" x2="14.5" y2="15" stroke="#FFFFFF" stroke-width="0.5" />
        </g>

        <!-- Front Wheel (Spins via JS) -->
        <g id="wavy-wheel-front" style="transform-origin: 37px 15px;">
          <circle cx="37" cy="15" r="3.4" fill="#18181B" stroke="#64748B" stroke-width="0.8" />
          <circle cx="37" cy="15" r="1.7" fill="#FB923C" />
          <line x1="37" y1="12.5" x2="37" y2="17.5" stroke="#FFFFFF" stroke-width="0.5" />
          <line x1="34.5" y1="15" x2="39.5" y2="15" stroke="#FFFFFF" stroke-width="0.5" />
        </g>

      </g>
    </g>
  </svg>
</div>

<script>
  function setupSquigglyProgressBar() {
    const wrap = document.getElementById('squiggly-road-wrap');
    const svg = document.getElementById('squiggly-svg');
    const roadBase = document.getElementById('wavy-road-base') as SVGPathElement | null;
    const roadDashes = document.getElementById('wavy-road-dashes') as SVGPathElement | null;
    const roadActive = document.getElementById('wavy-road-active') as SVGPathElement | null;
    const car = document.getElementById('wavy-car-runner');
    const finishLine = document.getElementById('wavy-finish-line');
    const wheelRear = document.getElementById('wavy-wheel-rear');
    const wheelFront = document.getElementById('wavy-wheel-front');

    if (!wrap || !svg || !roadBase || !roadDashes || !roadActive || !car) return;

    let totalLength = 0;
    let targetProgress = 0;
    let currentProgress = 0;
    let animFrameId: number | null = null;
    let width = window.innerWidth;
    const height = 28;
    const centerY = 14;

    // Build the squiggly road geometry across the full screen width
    function generateSquigglyPath() {
      width = window.innerWidth;
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);

      // Parameters for gentle, stylish road waves
      const startX = 0;
      const endX = width;
      const finishLineX = width - 24;
      const waveAmplitude = 4.5; // gentle, elegant vertical squiggle
      const wavelength = Math.min(160, Math.max(110, width / 9)); // adaptive wavelength
      
      // Start flat at x = 0, y = 14 for the first 30px
      let d = `M ${startX} ${centerY} L 30 ${centerY}`;

      // Build undulating sine-like bezier waves through the center
      const activeZoneEnd = Math.max(width - 70, 100);
      let curX = 30;
      let waveIndex = 0;

      while (curX + wavelength <= activeZoneEnd) {
        const halfWave = wavelength / 2;
        const crestY = waveIndex % 2 === 0 ? centerY - waveAmplitude : centerY + waveAmplitude;
        const troughY = waveIndex % 2 === 0 ? centerY + waveAmplitude : centerY - waveAmplitude;

        // Smooth cubic bezier wave
        const cp1X = curX + halfWave * 0.4;
        const cp1Y = crestY;
        const midX = curX + halfWave;
        const midY = centerY;
        const cp2X = midX + halfWave * 0.4;
        const cp2Y = troughY;
        const targetX = curX + wavelength;
        const targetY = centerY;

        d += ` C ${cp1X} ${cp1Y}, ${cp1X} ${cp1Y}, ${midX} ${midY}`;
        d += ` C ${cp2X} ${cp2Y}, ${cp2X} ${cp2Y}, ${targetX} ${targetY}`;

        curX += wavelength;
        waveIndex++;
      }

      // Smooth deceleration zone: gently flatten out into the finish line
      d += ` C ${curX + 20} ${centerY}, ${finishLineX - 20} ${centerY}, ${endX} ${centerY}`;

      // Update paths
      roadBase.setAttribute('d', d);
      roadDashes.setAttribute('d', d);
      roadActive.setAttribute('d', d);

      // Position finish line
      if (finishLine) {
        finishLine.setAttribute('transform', `translate(${finishLineX}, 0)`);
      }

      // Compute total path length
      totalLength = roadBase.getTotalLength();
      roadActive.style.strokeDasharray = `${totalLength}`;
      roadActive.style.strokeDashoffset = `${totalLength}`;

      // Update car immediately
      applyProgress(currentProgress);
    }

    // Apply exact car position and angle along the squiggly road
    function applyProgress(p: number) {
      if (totalLength <= 0) return;

      // Safe bounds: car starts at 24px and parks smoothly at finishLineX
      // When p reaches 1.0 (100% scrolled), park cleanly with bumper at finish line
      const safeCarHalfWidth = 24;
      const finishBuffer = 26; // px before the right screen edge
      const effectiveEndLength = Math.max(0, totalLength - finishBuffer);
      const effectiveStartLength = safeCarHalfWidth;
      
      const currentTravel = effectiveStartLength + p * (effectiveEndLength - effectiveStartLength);

      // Filled road path up to the front nose of the car
      const litDistance = Math.min(totalLength, currentTravel + 18);
      roadActive.style.strokeDashoffset = `${Math.max(0, totalLength - litDistance)}`;
      wrap.setAttribute('aria-valuenow', Math.round(p * 100).toString());

      // Get point along the squiggly road
      const point = roadBase.getPointAtLength(currentTravel);
      
      // Calculate tangent angle for realistic steering
      const lookAhead = Math.min(currentTravel + 4, totalLength);
      const nextPoint = roadBase.getPointAtLength(lookAhead);
      const dx = nextPoint.x - point.x;
      const dy = nextPoint.y - point.y;
      let angle = Math.atan2(dy, dx) * (180 / Math.PI);

      // Smooth finish transition: when within the final 6% (p > 0.94), gently dampen angle to 0° (level park)
      if (p > 0.94) {
        const endFactor = (1 - p) / 0.06; // 1 down to 0
        angle = angle * Math.max(0, Math.min(1, endFactor));
      }

      // Set car transform
      car.setAttribute('transform', `translate(${point.x}, ${point.y}) rotate(${angle})`);

      // Celebrate finish line smoothly when fully reached
      if (finishLine) {
        if (p >= 0.99) {
          finishLine.style.transform = `translate(${width - 24}px, 0) scale(1.15)`;
          finishLine.style.filter = 'drop-shadow(0 0 6px rgba(244, 63, 94, 0.8))';
        } else {
          finishLine.style.transform = `translate(${width - 24}px, 0) scale(1)`;
          finishLine.style.filter = 'none';
        }
      }

      // Rotate wheels smoothly with scroll movement
      const scrollY = window.scrollY;
      const wheelAngle = (scrollY * 2.2) % 360;
      if (wheelRear && wheelFront) {
        wheelRear.style.transform = `rotate(${wheelAngle}deg)`;
        wheelFront.style.transform = `rotate(${wheelAngle}deg)`;
      }
    }

    // Animation Loop for buttery-smooth ease-out transitions
    function renderLoop() {
      // Lerp (linear interpolation) for smooth, fluid car movement without stutter
      const delta = targetProgress - currentProgress;
      if (Math.abs(delta) > 0.0005) {
        currentProgress += delta * 0.18;
      } else {
        currentProgress = targetProgress;
      }

      applyProgress(currentProgress);

      if (Math.abs(targetProgress - currentProgress) > 0.0002) {
        animFrameId = requestAnimationFrame(renderLoop);
      } else {
        animFrameId = null;
      }
    }

    function onScroll() {
      const scrollY = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      targetProgress = maxScroll > 0 ? Math.min(Math.max(scrollY / maxScroll, 0), 1) : 0;

      if (!animFrameId) {
        animFrameId = requestAnimationFrame(renderLoop);
      }
    }

    function onResize() {
      generateSquigglyPath();
      onScroll();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });

    generateSquigglyPath();
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSquigglyProgressBar);
  } else {
    setupSquigglyProgressBar();
  }
  document.addEventListener('astro:page-load', setupSquigglyProgressBar);
</script>

<style>
  :global(html.dark) #wavy-road-base,
  :global(html[data-theme='night']) #wavy-road-base {
    stroke: rgba(17, 33, 74, 0.7) !important;
  }

  :global(html.dark) #wavy-road-dashes,
  :global(html[data-theme='night']) #wavy-road-dashes {
    stroke: rgba(0, 229, 255, 0.45) !important;
  }

  :global(html.dark) #wavy-road-active,
  :global(html[data-theme='night']) #wavy-road-active {
    stroke: url(#wavyNeonGrad) !important;
    filter: url(#highwayNeonGlow) !important;
  }
</style>
