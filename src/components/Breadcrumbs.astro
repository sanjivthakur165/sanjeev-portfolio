---
import { House, ChevronRight } from 'lucide-astro';

export interface Crumb {
  name: string;
  url: string;
}

export interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-4 mb-6">
  <ol class="inline-flex flex-wrap items-center gap-1 sm:gap-1.5 p-1.5 pr-2 rounded-full bg-white/75 dark:bg-night-ocean/75 backdrop-blur-md border border-rose-200/70 dark:border-night-cyan/25 shadow-sm shadow-rose-950/5 dark:shadow-night-midnight/40 text-xs sm:text-sm font-medium max-w-full">
    <li class="flex items-center">
      <a
        href="/"
        class="group flex items-center gap-2 pl-1 pr-3 py-1 rounded-full text-zinc-600 dark:text-night-muted hover:text-rose-600 dark:hover:text-night-cyan hover:bg-rose-50 dark:hover:bg-night-electric/30 transition-colors"
      >
        <span class="w-7 h-7 rounded-full bg-gradient-to-br from-rose-500 to-orange-400 dark:from-night-cyan dark:to-night-magenta text-white flex items-center justify-center shadow-sm transition-transform group-hover:scale-110">
          <House class="w-3.5 h-3.5" aria-hidden="true" />
        </span>
        Home
      </a>
    </li>

    {crumbs.map((crumb, idx) => {
      const isLast = idx === crumbs.length - 1;
      return (
        <li class="flex items-center gap-1 sm:gap-1.5 min-w-0">
          <ChevronRight class="w-4 h-4 flex-shrink-0 text-rose-300 dark:text-night-cyan/50" aria-hidden="true" />
          {isLast ? (
            <span
              class="px-3 py-1 rounded-full font-semibold text-white bg-gradient-to-r from-rose-500 via-pink-500 to-orange-400 dark:from-night-cyan dark:via-night-magenta dark:to-night-pink shadow-sm shadow-rose-500/25 dark:shadow-night-magenta/25 truncate max-w-[180px] sm:max-w-none"
              aria-current="page"
            >
              {crumb.name}
            </span>
          ) : (
            <a
              href={crumb.url}
              class="px-3 py-1 rounded-full text-zinc-600 dark:text-night-muted hover:text-rose-600 dark:hover:text-night-cyan hover:bg-rose-50 dark:hover:bg-night-electric/30 transition-colors truncate"
            >
              {crumb.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
