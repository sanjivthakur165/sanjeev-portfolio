---
import { profileData } from '../data/profile';
import SquigglyScrollRoad from './SquigglyScrollRoad.astro';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/case-studies/', label: 'Case Studies' },
  { href: '/projects/this-website/', label: 'How I Built This Site' },
  { href: '/contact/', label: 'Contact' },
];

const isActive = (path: string) => {
  if (path === '/' && currentPath === '/') return true;
  if (path !== '/' && currentPath.startsWith(path)) return true;
  return false;
};
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/85 dark:bg-night-midnight/90 backdrop-blur-md border-b border-rose-100/70 dark:border-night-cyan/20 shadow-sm dark:shadow-night-midnight/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand / Logo -->
      <a href="/" class="group flex items-center space-x-3 text-left focus:outline-none focus:ring-2 focus:ring-rose-400 dark:focus:ring-night-cyan rounded-lg p-1">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-rose-500 via-pink-400 to-orange-400 dark:from-night-cyan dark:via-night-magenta dark:to-night-pink flex items-center justify-center text-white font-serif font-bold text-lg shadow-md shadow-rose-500/20 dark:shadow-night-magenta/30 group-hover:scale-105 transition-transform">
          ST
        </div>
        <div class="flex flex-col">
          <span class="font-serif text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-night-light group-hover:text-rose-600 dark:group-hover:text-night-cyan transition-colors">
            {profileData.name}
          </span>
          <span class="text-xs uppercase tracking-widest font-mono font-medium text-rose-500 dark:text-night-cyan">
            {profileData.role}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-0.5 xl:space-x-1" aria-label="Main Navigation">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class={`px-3 xl:px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap transition-all duration-200 ${
                active
                  ? 'bg-rose-50 text-rose-600 font-semibold shadow-sm border border-rose-200/60 dark:bg-night-ocean dark:text-night-cyan dark:border-night-cyan/40 dark:shadow-night-cyan/15'
                  : 'text-zinc-600 dark:text-night-muted hover:text-rose-600 dark:hover:text-night-cyan hover:bg-rose-50/50 dark:hover:bg-night-ocean/50'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Right Controls: Theme Switcher & Contact CTA -->
      <div class="hidden lg:flex items-center space-x-3">
        <!-- DAY | NIGHT Theme Switcher -->
        <ThemeToggle />

        <a
          href="/contact/"
          class="hidden xl:inline-flex items-center justify-center px-5 py-2.5 rounded-full text-sm font-semibold text-white whitespace-nowrap bg-gradient-to-r from-rose-500 to-orange-400 dark:from-night-magenta dark:to-night-pink hover:from-rose-600 hover:to-orange-500 dark:hover:from-night-magenta dark:hover:to-night-cyan shadow-sm shadow-rose-500/25 dark:shadow-night-magenta/30 hover:shadow-md transition-all transform hover:-translate-y-0.5 active:translate-y-0"
        >
          Let's Connect
          <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button & Theme Switcher (Mobile) -->
      <div class="flex items-center space-x-2 lg:hidden">
        <ThemeToggle />
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2 rounded-xl text-zinc-700 dark:text-night-light hover:text-rose-600 dark:hover:text-night-cyan hover:bg-rose-50 dark:hover:bg-night-ocean focus:outline-none focus:ring-2 focus:ring-rose-500 dark:focus:ring-night-cyan"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle navigation menu"
        >
          <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-rose-100 dark:border-night-cyan/20 bg-white/95 dark:bg-night-midnight/98 backdrop-blur-xl px-4 pt-3 pb-6 space-y-2">
    {navLinks.map((link) => {
      const active = isActive(link.href);
      return (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-xl text-base font-medium transition-colors ${
            active
              ? 'bg-rose-50 text-rose-600 font-bold border border-rose-200 dark:bg-night-ocean dark:text-night-cyan dark:border-night-cyan/40'
              : 'text-zinc-700 dark:text-night-muted hover:bg-rose-50 dark:hover:bg-night-ocean hover:text-rose-600 dark:hover:text-night-cyan'
          }`}
          aria-current={active ? 'page' : undefined}
        >
          {link.label}
        </a>
      );
    })}
    <div class="pt-4 border-t border-rose-100/60 dark:border-night-ocean">
      <a
        href="/contact/"
        class="w-full flex items-center justify-center px-5 py-3 rounded-xl text-base font-semibold text-white bg-gradient-to-r from-rose-500 to-orange-400 dark:from-night-magenta dark:to-night-pink shadow-md shadow-rose-500/20 dark:shadow-night-magenta/30"
      >
        Let's Connect
      </a>
    </div>
  </div>

  <!-- GTA VI Squiggly Scroll Highway & Driving Supercar -->
  <SquigglyScrollRoad />
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (menuBtn && mobileMenu && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (!menuBtn.contains(target) && !mobileMenu.contains(target) && !mobileMenu.classList.contains('hidden')) {
        menuBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  }
</script>
