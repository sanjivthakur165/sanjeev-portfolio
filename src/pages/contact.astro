---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { profileData } from '../data/profile';

const crumbs = [
  { name: 'Contact', url: '/contact' }
];
---

<BaseLayout
  title="Contact Sanjeev Thakur | SEO Specialist"
  description="Contact Sanjeev Thakur about SEO Specialist roles, technical SEO audits or freelance SEO work, by email, phone or LinkedIn."
  canonicalPath="/contact"
  pageType="contact"
  breadcrumbs={crumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <Breadcrumbs crumbs={crumbs} />

    <!-- Editorial Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full text-xs font-mono font-semibold tracking-wider uppercase bg-rose-100 dark:bg-night-ocean text-rose-700 dark:text-night-cyan border border-rose-200 dark:border-night-cyan/30 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-500 dark:bg-night-cyan"></span>
        <span>Let's Connect</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-extrabold text-zinc-900 dark:text-night-light leading-[1.1] mb-6">
        Let's Talk About Your <span class="text-gradient-vice">Search Goals.</span>
      </h1>
      <p class="text-lg sm:text-xl text-zinc-600 dark:text-night-muted leading-relaxed font-normal">
        I'm open to full-time SEO roles and a few freelance projects. Send me a message and I'll get back to you.
      </p>
    </div>

    <!-- Contact Grid: Form on Left, Direct Contact Details on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-24">
      
      <!-- Left Column: Frontend Contact Form -->
      <div class="lg:col-span-7 bg-glass-card rounded-3xl p-8 sm:p-10 border border-rose-100/80 dark:border-night-cyan/20">
        
        <div class="mb-6">
          <h2 class="text-2xl font-serif font-bold text-zinc-900 dark:text-night-light">
            Send a Message
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-night-muted mt-1">
            Fill in the form below. If it's urgent, email me directly.
          </p>
        </div>

        <!-- Local Development Backend Notice -->
        <div class="p-4 rounded-xl bg-rose-50 dark:bg-night-ocean/80 border border-rose-200 dark:border-night-coral/30 mb-8 flex items-start space-x-3 text-xs text-rose-900 dark:text-night-light">
          <span class="text-base flex-shrink-0">ℹ️</span>
          <p class="leading-relaxed">
            <strong>Heads up:</strong> this form isn't connected yet. It will be once the site is live. Until then, please email me at <a href={`mailto:${profileData.email}`} class="font-bold underline text-rose-700 dark:text-night-coral">{profileData.email}</a>.
          </p>
        </div>

        <form id="contact-form" class="space-y-6">
          <div>
            <label for="name" class="block text-xs font-mono font-bold uppercase tracking-wider text-zinc-700 dark:text-night-muted mb-2">
              Full Name <span class="text-rose-500 dark:text-night-pink">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="e.g. Jane Doe"
              class="w-full px-4 py-3 rounded-xl bg-white/90 dark:bg-night-midnight/60 border border-rose-200 dark:border-night-cyan/40 text-zinc-900 dark:text-night-light placeholder-zinc-400 dark:placeholder-night-muted/60 focus:outline-none focus:ring-2 focus:ring-rose-400 dark:focus:ring-night-cyan focus:border-rose-400 dark:focus:border-night-cyan transition-all text-sm"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-mono font-bold uppercase tracking-wider text-zinc-700 dark:text-night-muted mb-2">
              Email Address <span class="text-rose-500 dark:text-night-pink">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="e.g. jane@company.com"
              class="w-full px-4 py-3 rounded-xl bg-white/90 dark:bg-night-midnight/60 border border-rose-200 dark:border-night-cyan/40 text-zinc-900 dark:text-night-light placeholder-zinc-400 dark:placeholder-night-muted/60 focus:outline-none focus:ring-2 focus:ring-rose-400 dark:focus:ring-night-cyan focus:border-rose-400 dark:focus:border-night-cyan transition-all text-sm"
            />
          </div>

          <div>
            <label for="subject" class="block text-xs font-mono font-bold uppercase tracking-wider text-zinc-700 dark:text-night-muted mb-2">
              Subject <span class="text-rose-500 dark:text-night-pink">*</span>
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              placeholder="e.g. SEO Specialist Role / Technical Audit Enquiry"
              class="w-full px-4 py-3 rounded-xl bg-white/90 dark:bg-night-midnight/60 border border-rose-200 dark:border-night-cyan/40 text-zinc-900 dark:text-night-light placeholder-zinc-400 dark:placeholder-night-muted/60 focus:outline-none focus:ring-2 focus:ring-rose-400 dark:focus:ring-night-cyan focus:border-rose-400 dark:focus:border-night-cyan transition-all text-sm"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-mono font-bold uppercase tracking-wider text-zinc-700 dark:text-night-muted mb-2">
              Message <span class="text-rose-500 dark:text-night-pink">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Tell me about your website, your goals or the role you're hiring for..."
              class="w-full px-4 py-3 rounded-xl bg-white/90 dark:bg-night-midnight/60 border border-rose-200 dark:border-night-cyan/40 text-zinc-900 dark:text-night-light placeholder-zinc-400 dark:placeholder-night-muted/60 focus:outline-none focus:ring-2 focus:ring-rose-400 dark:focus:ring-night-cyan focus:border-rose-400 dark:focus:border-night-cyan transition-all text-sm resize-y"
            ></textarea>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-full text-sm font-bold text-white bg-gradient-to-r from-rose-500 via-pink-500 to-orange-400 dark:from-night-magenta dark:via-night-pink dark:to-night-cyan hover:from-rose-600 hover:to-orange-500 dark:hover:from-night-magenta dark:hover:to-night-pink shadow-lg shadow-rose-500/25 dark:shadow-night-magenta/30 transition-all transform hover:-translate-y-0.5"
            >
              Send Message
              <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </div>

          <!-- Interactive Client Notification Box (Triggered via JS) -->
          <div id="form-feedback" class="hidden p-4 rounded-xl bg-emerald-50 dark:bg-night-ocean/90 border border-emerald-200 dark:border-night-cyan/40 text-xs text-emerald-800 dark:text-night-light">
            <strong>Thanks!</strong> The form is still a demo, so please also email me at <a href={`mailto:${profileData.email}`} class="underline font-bold text-emerald-900 dark:text-night-cyan">{profileData.email}</a> so I don't miss it.
          </div>
        </form>

      </div>

      <!-- Right Column: Direct Contact Details & Links -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Direct Channels Card -->
        <div class="bg-glass-card rounded-3xl p-8 border border-rose-100/80 dark:border-night-cyan/20 space-y-6">
          <h2 class="text-2xl font-serif font-bold text-zinc-900 dark:text-night-light">
            Direct Contact Information
          </h2>
          <p class="text-sm text-zinc-600 dark:text-night-muted leading-relaxed">
            I reply quickly to recruiters and project enquiries. Use whichever channel suits you.
          </p>

          <div class="space-y-4 pt-2">
            <!-- Email -->
            <a
              href={`mailto:${profileData.email}`}
              class="p-4 rounded-2xl bg-white dark:bg-night-ocean/80 border border-rose-100 dark:border-night-cyan/20 flex items-center space-x-4 hover:border-rose-300 dark:hover:border-night-cyan/50 transition-all group"
            >
              <div class="w-11 h-11 rounded-xl bg-rose-100 dark:bg-night-midnight text-rose-600 dark:text-night-pink flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div class="overflow-hidden">
                <div class="text-xs font-mono uppercase text-zinc-400 dark:text-night-muted/70 font-semibold">Email</div>
                <div class="text-sm sm:text-base font-bold text-zinc-900 dark:text-night-light group-hover:text-rose-600 dark:group-hover:text-night-cyan transition-colors truncate">
                  {profileData.email}
                </div>
              </div>
            </a>

            <!-- Phone -->
            <a
              href={`tel:${profileData.phone}`}
              class="p-4 rounded-2xl bg-white dark:bg-night-ocean/80 border border-rose-100 dark:border-night-cyan/20 flex items-center space-x-4 hover:border-rose-300 dark:hover:border-night-cyan/50 transition-all group"
            >
              <div class="w-11 h-11 rounded-xl bg-orange-100 dark:bg-night-midnight text-orange-600 dark:text-night-coral flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <div class="text-xs font-mono uppercase text-zinc-400 dark:text-night-muted/70 font-semibold">Phone</div>
                <div class="text-sm sm:text-base font-bold text-zinc-900 dark:text-night-light group-hover:text-rose-600 dark:group-hover:text-night-cyan transition-colors">
                  {profileData.phone}
                </div>
              </div>
            </a>

            <!-- LinkedIn -->
            <a
              href={profileData.linkedIn}
              target="_blank"
              rel="noopener noreferrer"
              class="p-4 rounded-2xl bg-white dark:bg-night-ocean/80 border border-rose-100 dark:border-night-cyan/20 flex items-center space-x-4 hover:border-rose-300 dark:hover:border-night-cyan/50 transition-all group"
            >
              <div class="w-11 h-11 rounded-xl bg-purple-100 dark:bg-night-midnight text-purple-600 dark:text-night-lavender flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </div>
              <div>
                <div class="text-xs font-mono uppercase text-zinc-400 dark:text-night-muted/70 font-semibold">LinkedIn Profile</div>
                <div class="text-sm sm:text-base font-bold text-zinc-900 dark:text-night-light group-hover:text-rose-600 dark:group-hover:text-night-cyan transition-colors">
                  linkedin.com/in/sanjeev165/
                </div>
              </div>
            </a>

            <!-- Location -->
            <div class="p-4 rounded-2xl bg-white/60 dark:bg-night-ocean/60 border border-rose-100 dark:border-night-cyan/20 flex items-center space-x-4">
              <div class="w-11 h-11 rounded-xl bg-pink-50 dark:bg-night-midnight text-pink-500 dark:text-night-cyan flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <div class="text-xs font-mono uppercase text-zinc-400 dark:text-night-muted/70 font-semibold">Current Base</div>
                <div class="text-sm sm:text-base font-bold text-zinc-800 dark:text-night-light">
                  {profileData.location}
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Working Arrangement Box -->
        <div class="bg-glass-card rounded-2xl p-6 border border-rose-100/80 dark:border-night-cyan/20">
          <h3 class="font-serif font-bold text-zinc-900 dark:text-night-light text-base mb-2">Available For</h3>
          <ul class="space-y-2 text-xs sm:text-sm text-zinc-600 dark:text-night-muted">
            <li class="flex items-center">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-night-cyan mr-2 flex-shrink-0"></span>
              Full-time in-house SEO roles
            </li>
            <li class="flex items-center">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-night-cyan mr-2 flex-shrink-0"></span>
              Technical SEO audits and site restructuring
            </li>
            <li class="flex items-center">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-night-cyan mr-2 flex-shrink-0"></span>
              Freelance local SEO for service businesses
            </li>
          </ul>
        </div>

      </div>

    </div>

  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      feedback.classList.remove('hidden');
      form.reset();
    });
  }
</script>
