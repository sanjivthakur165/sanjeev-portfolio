---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { profileData } from '../data/profile';

const crumbs = [
  { name: 'About', url: '/about' }
];
---

<BaseLayout
  title="About Sanjeev Thakur | SEO Specialist"
  description="Learn more about Sanjeev Thakur, an SEO Specialist with 4+ years experience. Discover his background in Technical SEO, on-page architecture, team leadership, and interest in AEO & GEO."
  canonicalPath="/about"
  breadcrumbs={crumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <Breadcrumbs crumbs={crumbs} />

    <!-- Editorial Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full text-xs font-mono font-semibold tracking-wider uppercase bg-rose-100 dark:bg-night-ocean text-rose-700 dark:text-night-cyan border border-rose-200 dark:border-night-cyan/30 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-500 dark:bg-night-cyan"></span>
        <span>About Sanjeev Thakur</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-extrabold text-zinc-900 dark:text-night-light leading-[1.1] mb-6">
        Bridging Technical Execution &amp; <span class="text-gradient-vice">Organic Search Growth.</span>
      </h1>
      <p class="text-lg sm:text-xl text-zinc-600 dark:text-night-muted leading-relaxed font-normal">
        Over 4 years of hands-on experience transforming websites from crawlable obstacles into discoverable, high-converting organic search assets.
      </p>
    </div>

    <!-- Career Story Narrative (Editorial Magazine Spread) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-24">
      
      <!-- Left Column: Story Blocks -->
      <div class="lg:col-span-8 space-y-8 text-zinc-700 dark:text-night-muted text-base sm:text-lg leading-relaxed">
        
        <div class="bg-glass-card rounded-3xl p-8 sm:p-10 border border-rose-100/80 dark:border-night-cyan/20 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-zinc-900 dark:text-night-light">
            My SEO Journey &amp; Engineering Foundation
          </h2>
          <p>
            With an academic background in <strong class="text-zinc-900 dark:text-night-light">Computer Science (B.Tech)</strong>, I have always looked at search engines through the lens of systems, logic, and crawl mechanics. Rather than treating SEO as mere keyword sprinkling or surface-level copywriting, I approach every website as an interconnected digital architecture that search engine bots must parse, render, evaluate, and prioritize.
          </p>
          <p>
            Over the past four years, that foundational mindset has evolved through rigorous agency and client-facing execution—solving complex crawlability barriers, structuring scalable internal link networks, and aligning high-intent commercial queries with relevant landing page experiences.
          </p>
        </div>

        <div class="bg-glass-card rounded-3xl p-8 sm:p-10 border border-rose-100/80 dark:border-night-cyan/20 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-zinc-900 dark:text-night-light">
            Current Leadership: vSplash Techlabs
          </h2>
          <p>
            Since September 2023, I have served as an <strong class="text-zinc-900 dark:text-night-light">SEO Specialist at vSplash Techlabs</strong>. In this role, I am responsible for end-to-end SEO execution across a diverse portfolio of client websites spanning competitive industries and regional markets.
          </p>
          <p>
            Beyond direct technical auditing and on-page optimization, I actively <strong class="text-zinc-900 dark:text-night-light">mentor and supervise a team of four SEO associates</strong>. This includes establishing standard operating procedures for site crawls, reviewing metadata and keyword mapping deliverables, troubleshooting crawlability bottlenecks, and liaising directly with cross-functional development teams to guarantee seamless implementation.
          </p>
          <ul class="space-y-3 pt-2 text-sm sm:text-base text-zinc-700 dark:text-night-muted">
            <li class="flex items-start">
              <span class="text-rose-500 dark:text-night-cyan font-bold mr-3 mt-1">✓</span>
              <span><strong class="text-zinc-900 dark:text-night-light">Technical Auditing:</strong> Diagnosing server response codes, crawl bloat, broken links, XML sitemap flaws, and media payloads using Screaming Frog and Google Search Console.</span>
            </li>
            <li class="flex items-start">
              <span class="text-rose-500 dark:text-night-cyan font-bold mr-3 mt-1">✓</span>
              <span><strong class="text-zinc-900 dark:text-night-light">On-Page Precision:</strong> Crafting semantic keyword architectures, heading hierarchies, title tags, and structured meta assets mapped to clear user intent.</span>
            </li>
            <li class="flex items-start">
              <span class="text-rose-500 dark:text-night-cyan font-bold mr-3 mt-1">✓</span>
              <span><strong class="text-zinc-900 dark:text-night-light">Team Leadership:</strong> Leading 4 associates through daily execution, quality assurance, and technical training.</span>
            </li>
          </ul>
        </div>

        <div class="bg-glass-card rounded-3xl p-8 sm:p-10 border border-rose-100/80 dark:border-night-cyan/20 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-zinc-900 dark:text-night-light">
            Early Agency Grounding: Baweja Media
          </h2>
          <p>
            My professional career gained early velocity at <strong class="text-zinc-900 dark:text-night-light">Baweja Media</strong> (December 2022 – May 2023), where I worked as an SEO Intern. There, I gained intensive practical exposure to the foundational levers of off-page authority building, competitive backlink analysis, and on-page structural improvements.
          </p>
          <p>
            Executing over ten distinct off-page campaigns taught me the nuances of organic authority distribution, competitive gap discovery, and the vital role that content relevance plays in securing durable rankings.
          </p>
        </div>

        <div class="bg-glass-card rounded-3xl p-8 sm:p-10 border border-rose-100/80 dark:border-night-cyan/20 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-zinc-900 dark:text-night-light">
            My SEO Approach &amp; Philosophy
          </h2>
          <p>
            I believe that sustainable SEO cannot rely on shortcuts, vanity metrics, or algorithm gaming. True search performance rests upon three core tenets:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-white dark:bg-night-ocean/80 border border-rose-100 dark:border-night-cyan/20">
              <div class="font-serif font-bold text-zinc-900 dark:text-night-light mb-1">1. Crawlability First</div>
              <div class="text-xs text-zinc-600 dark:text-night-muted">If Google cannot seamlessly discover and index your content, on-page optimization is wasted effort.</div>
            </div>
            <div class="p-4 rounded-xl bg-white dark:bg-night-ocean/80 border border-rose-100 dark:border-night-cyan/20">
              <div class="font-serif font-bold text-zinc-900 dark:text-night-light mb-1">2. Search Intent Fit</div>
              <div class="text-xs text-zinc-600 dark:text-night-muted">Aligning page depth and copy to whether the searcher wants to learn, compare, or buy.</div>
            </div>
            <div class="p-4 rounded-xl bg-white dark:bg-night-ocean/80 border border-rose-100 dark:border-night-cyan/20">
              <div class="font-serif font-bold text-zinc-900 dark:text-night-light mb-1">3. Honest Attribution</div>
              <div class="text-xs text-zinc-600 dark:text-night-muted">Transparent reporting with GA4 &amp; GSC without inflating early impressions into fake conversions.</div>
            </div>
          </div>
        </div>

        <div class="bg-glass-card rounded-3xl p-8 sm:p-10 border border-rose-200 dark:border-night-pink/30 space-y-6">
          <div class="flex items-center space-x-2 text-rose-600 dark:text-night-pink font-mono text-xs uppercase font-bold tracking-wider">
            <span>Research &amp; Future Outlook</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-zinc-900 dark:text-night-light">
            Preparing for AEO &amp; GEO (AI-Powered Search)
          </h2>
          <p>
            The landscape of search is experiencing its most profound evolution since the inception of mobile search. With the advent of Google's AI Overviews, Perplexity, ChatGPT Search, and Claude, traditional keyword rankings are being augmented by citation visibility, entity authority, and conversational answer retrieval.
          </p>
          <p>
            I am actively researching <strong class="text-zinc-900 dark:text-night-light">Answer Engine Optimization (AEO)</strong> and <strong class="text-zinc-900 dark:text-night-light">Generative Engine Optimization (GEO)</strong>—investigating how structured data, comprehensive semantic entity definitions, and authoritative answer passages influence inclusion in LLM-synthesized search answers.
          </p>
        </div>

      </div>

      <!-- Right Column: Sidebar Quick Facts & Sticky Card -->
      <div class="lg:col-span-4 space-y-6 sticky top-28">
        
        <!-- Profile Card -->
        <div class="bg-glass-card rounded-3xl p-6 sm:p-8 border border-rose-100 dark:border-night-cyan/20 text-center">
          <div class="w-32 h-36 mx-auto rounded-2xl overflow-hidden bg-rose-50 dark:bg-night-ocean border-2 border-rose-200 dark:border-night-cyan/30 mb-4 p-1">
            <img
              src="/images/profile-placeholder.svg"
              alt="Sanjeev Thakur portrait placeholder"
              class="w-full h-full object-cover rounded-xl"
              width="128"
              height="144"
            />
          </div>
          <h3 class="font-serif text-2xl font-bold text-zinc-900 dark:text-night-light">{profileData.name}</h3>
          <p class="text-sm font-mono text-rose-600 dark:text-night-cyan font-semibold uppercase tracking-wider mt-1">{profileData.role}</p>
          <p class="text-xs text-zinc-500 dark:text-night-muted mt-2">{profileData.location}</p>

          <div class="mt-6 pt-6 border-t border-rose-100 dark:border-night-cyan/20 space-y-3 text-left text-xs text-zinc-700 dark:text-night-light">
            <div class="flex justify-between">
              <span class="text-zinc-500 dark:text-night-muted">Experience:</span>
              <span class="font-semibold">{profileData.yearsOfExperience}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-zinc-500 dark:text-night-muted">Current Role:</span>
              <span class="font-semibold">vSplash Techlabs</span>
            </div>
            <div class="flex justify-between">
              <span class="text-zinc-500 dark:text-night-muted">Team Size Led:</span>
              <span class="font-semibold">4 SEO Associates</span>
            </div>
            <div class="flex justify-between">
              <span class="text-zinc-500 dark:text-night-muted">Degree:</span>
              <span class="font-semibold">B.Tech Computer Science</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-rose-100 dark:border-night-cyan/20">
            <a
              href="/contact"
              class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-full text-xs font-bold text-white bg-gradient-to-r from-rose-500 to-orange-400 dark:from-night-magenta dark:to-night-cyan shadow-sm hover:shadow-md transition-all"
            >
              Get In Touch
            </a>
          </div>
        </div>

        <!-- Verified Competencies Box -->
        <div class="bg-glass-card rounded-2xl p-6 border border-rose-100/80 dark:border-night-cyan/20">
          <h4 class="font-serif font-bold text-zinc-900 dark:text-night-light text-base mb-3">Key Competencies</h4>
          <div class="flex flex-wrap gap-1.5 text-xs">
            <span class="px-2.5 py-1 rounded-md bg-rose-50 dark:bg-night-ocean text-rose-700 dark:text-night-cyan border border-rose-100 dark:border-night-cyan/30">Technical SEO Audits</span>
            <span class="px-2.5 py-1 rounded-md bg-rose-50 dark:bg-night-ocean text-rose-700 dark:text-night-cyan border border-rose-100 dark:border-night-cyan/30">Crawlability &amp; Indexation</span>
            <span class="px-2.5 py-1 rounded-md bg-rose-50 dark:bg-night-ocean text-rose-700 dark:text-night-cyan border border-rose-100 dark:border-night-cyan/30">Keyword Mapping</span>
            <span class="px-2.5 py-1 rounded-md bg-rose-50 dark:bg-night-ocean text-rose-700 dark:text-night-cyan border border-rose-100 dark:border-night-cyan/30">Local SEO &amp; GBP</span>
            <span class="px-2.5 py-1 rounded-md bg-rose-50 dark:bg-night-ocean text-rose-700 dark:text-night-cyan border border-rose-100 dark:border-night-cyan/30">Google Search Console</span>
            <span class="px-2.5 py-1 rounded-md bg-rose-50 dark:bg-night-ocean text-rose-700 dark:text-night-cyan border border-rose-100 dark:border-night-cyan/30">Google Analytics 4</span>
            <span class="px-2.5 py-1 rounded-md bg-rose-50 dark:bg-night-ocean text-rose-700 dark:text-night-cyan border border-rose-100 dark:border-night-cyan/30">AEO &amp; GEO Research</span>
          </div>
        </div>

      </div>

    </div>

    <!-- Career Timeline Component -->
    <div class="mb-24">
      <SectionHeading
        badge="TIMELINE"
        title="Experience &amp; Academic Background"
        subtitle="Full chronological overview of my professional roles and computer science degree."
      />
      <ExperienceTimeline />
    </div>

    <!-- Contact CTA -->
    <ContactCTA />

  </div>
</BaseLayout>
