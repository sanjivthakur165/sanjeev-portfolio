---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ToolsGrid from '../components/ToolsGrid.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { caseStudies } from '../data/case-studies';
import { profileData } from '../data/profile';
---

<BaseLayout
  title="SEO Specialist | Technical, On-Page & Local SEO"
  description="Personal portfolio of Sanjeev Thakur, an SEO Specialist with 4+ years experience driving sustainable organic search growth through Technical SEO, On-Page Optimization, and Local SEO."
  canonicalPath="/"
>
  <!-- 1. Hero Section -->
  <Hero />

  <!-- 2. Professional Introduction -->
  <section class="py-16 sm:py-24 border-t border-rose-100/70 dark:border-night-cyan/15 bg-white/40 dark:bg-night-ocean/20 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-5 space-y-4">
          <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full text-xs font-mono font-semibold tracking-wider uppercase bg-rose-100 dark:bg-night-ocean text-rose-700 dark:text-night-cyan border border-rose-200 dark:border-night-cyan/30">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 dark:bg-night-cyan"></span>
            <span>Professional Positioning</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-zinc-900 dark:text-night-light leading-tight">
            Engineering Search Equity Beyond Quick Fixes.
          </h2>
          <p class="text-zinc-600 dark:text-night-muted text-base leading-relaxed">
            Search engines reward clean architecture, clear intent matching, and undeniable technical health. My approach is built on measurable execution—diagnosing crawl barriers, structuring content hubs, and scaling regional authority.
          </p>
          <div class="pt-2">
            <a
              href="/about"
              class="inline-flex items-center text-sm font-semibold text-rose-600 dark:text-night-cyan hover:text-rose-700 dark:hover:text-night-pink group transition-colors"
            >
              Read My Full Career Background
              <svg class="ml-2 w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-glass-card p-6 rounded-2xl">
            <div class="w-10 h-10 rounded-xl bg-rose-100 dark:bg-night-ocean text-rose-600 dark:text-night-cyan border border-transparent dark:border-night-cyan/30 flex items-center justify-center font-bold text-lg mb-4">
              01
            </div>
            <h3 class="font-serif text-lg font-bold text-zinc-900 dark:text-night-light mb-2">Technical Rigor</h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-night-muted leading-relaxed">
              Leveraging a computer science foundation to resolve deep crawling, rendering, status code, XML sitemap, and internal link barriers.
            </p>
          </div>

          <div class="bg-glass-card p-6 rounded-2xl">
            <div class="w-10 h-10 rounded-xl bg-orange-100 dark:bg-night-ocean text-orange-600 dark:text-night-coral border border-transparent dark:border-night-coral/30 flex items-center justify-center font-bold text-lg mb-4">
              02
            </div>
            <h3 class="font-serif text-lg font-bold text-zinc-900 dark:text-night-light mb-2">Intent-Driven Architecture</h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-night-muted leading-relaxed">
              Mapping keyword universes to high-converting service offerings and geo-targeted landing pages that satisfy commercial intent.
            </p>
          </div>

          <div class="bg-glass-card p-6 rounded-2xl">
            <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-night-ocean text-purple-600 dark:text-night-lavender border border-transparent dark:border-night-lavender/30 flex items-center justify-center font-bold text-lg mb-4">
              03
            </div>
            <h3 class="font-serif text-lg font-bold text-zinc-900 dark:text-night-light mb-2">Team Leadership</h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-night-muted leading-relaxed">
              Guiding and mentoring four SEO associates at vSplash Techlabs, standardizing QA audits, task delegation, and execution workflows.
            </p>
          </div>

          <div class="bg-glass-card p-6 rounded-2xl">
            <div class="w-10 h-10 rounded-xl bg-pink-100 dark:bg-night-ocean text-pink-600 dark:text-night-pink border border-transparent dark:border-night-pink/30 flex items-center justify-center font-bold text-lg mb-4">
              04
            </div>
            <h3 class="font-serif text-lg font-bold text-zinc-900 dark:text-night-light mb-2">Future-Ready Research</h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-night-muted leading-relaxed">
              Continuously investigating generative search mechanics (GEO) and answer engines (AEO) to insulate websites against algorithmic disruption.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 3. SEO Expertise Section -->
  <section class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        badge="CAPABILITIES"
        title="Comprehensive SEO Expertise"
        subtitle="Organized across core disciplines—from technical server-level crawl audits to localized map dominance and generative search awareness."
      />
      <SkillsGrid />
    </div>
  </section>

  <!-- 4. Featured Case Studies -->
  <section class="py-16 sm:py-24 border-t border-rose-100/70 dark:border-night-cyan/15 bg-gradient-to-b from-rose-50/20 via-white/50 to-orange-50/20 dark:from-night-midnight/40 dark:via-night-ocean/20 dark:to-night-midnight/40 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        badge="MEASURABLE IMPACT"
        title="Featured Client Case Studies"
        subtitle="Documented search performance milestones across competitive South Florida markets. Client names and proprietary data remain strictly confidential."
      />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
        {caseStudies.map((cs) => (
          <CaseStudyCard caseStudy={cs} />
        ))}
      </div>

      <div class="text-center">
        <a
          href="/case-studies"
          class="inline-flex items-center px-6 py-3 rounded-full text-sm font-semibold text-zinc-800 dark:text-night-light bg-white dark:bg-night-ocean hover:bg-rose-50 dark:hover:bg-night-ocean/70 border border-rose-200 dark:border-night-cyan/30 shadow-sm transition-all hover:border-rose-300 dark:hover:border-night-cyan"
        >
          Explore All Case Study Breakdowns &amp; Strategies
          <svg class="ml-2 w-4 h-4 text-rose-500 dark:text-night-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Professional Experience -->
  <section class="py-16 sm:py-24 border-t border-rose-100/70 dark:border-night-cyan/15">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        badge="CAREER PATHWAY"
        title="Professional Experience"
        subtitle="A proven track record spanning hands-on agency optimization, team supervision, and cross-functional technical collaboration."
      />
      <ExperienceTimeline />
    </div>
  </section>

  <!-- 6. Tools and Technologies -->
  <section class="py-16 sm:py-24 border-t border-rose-100/70 dark:border-night-cyan/15 bg-white/40 dark:bg-night-ocean/20 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        badge="TECH STACK"
        title="Tools &amp; Technologies"
        subtitle="Industry-standard platforms utilized for crawl diagnostics, competitive intelligence, keyword research, and analytics attribution."
      />
      <ToolsGrid />
    </div>
  </section>

  <!-- 7. Contact CTA -->
  <section class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactCTA />
    </div>
  </section>
</BaseLayout>
